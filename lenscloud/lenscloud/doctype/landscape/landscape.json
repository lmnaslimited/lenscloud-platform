{
 "doctype": "DocType",
 "name": "Landscape",
 "module": "Lenscloud",
 "engine": "InnoDB",
 "allow_rename": 1,
 "grid_page_length": 50,
 "row_format": "Dynamic",
 "sort_field": "creation",
 "sort_order": "DESC",
 "fields": [
  {
   "fieldname": "title",
   "fieldtype": "Data",
   "label": "Title",
   "reqd": 1,
   "unique": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "tier_count",
   "fieldtype": "Int",
   "label": "Tier Count",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "version",
   "fieldtype": "Int",
   "label": "Version",
   "default": "1",
   "reqd": 1
  },
  {
   "fieldname": "status",
   "fieldtype": "Select",
   "label": "Status",
   "options": "Draft\nActive\nRetired",
   "default": "Draft",
   "in_list_view": 1
  },
  {
   "fieldname": "environments",
   "fieldtype": "Table",
   "label": "Environments",
   "options": "Landscape Environment",
   "reqd": 1
  }
 ],
 "field_order": [
  "title",
  "tier_count",
  "version",
  "status",
  "environments"
 ],
 "permissions": [
  {
   "role": "System Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "delete": 1,
   "email": 1,
   "export": 1,
   "print": 1,
   "report": 1,
   "share": 1
  }
 ],
 "autoname": "field:title",
 "naming_rule": "By fieldname",
 "title_field": "title"
}
